CT_CONFIG_VERSION="4"
CT_EXPERIMENTAL=y
CT_ALLOW_BUILD_AS_ROOT=n
CT_PREFIX_DIR="/home/b/x-tools/${CT_TARGET}"
CT_ARCH_MIPS=y
CT_ARCH_LE=y
CT_ARCH_32=y
CT_ARCH_ARCH="mips32r2"
CT_ARCH_FLOAT_HW=y
CT_TARGET_VENDOR="disc"
CT_TARGET_CFLAGS="-mnan=2008 -mfp64"
CT_KERNEL_LINUX=y
CT_LINUX_V_4_9=y
CT_GLIBC_V_2_29=y
CT_GLIBC_ENABLE_OBSOLETE_LIBCRYPT=y
CT_GCC_V_8=y
CT_CC_GCC_EXTRA_CONFIG_ARRAY="--with-nan=2008 --with-fp-32=64"
CT_CC_LANG_CXX=y
CT_LOG_PROGRESS_BAR=n
CT_GLIBC_KERNEL_VERSION_AS_HEADERS=y
